<mxfile host="app.diagrams.net"><diagram id="design-adapters" name="设备与AI适配接口设计类图"><mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1700" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="«control»&#10;设备使用服务&#10;UC2 · UC3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontColor=#1B3A5C;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="240" height="90" as="geometry"/></mxCell><mxCell id="c2" value="«control»&#10;设备接入服务&#10;UC5 · G1–G3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontColor=#1B3A5C;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="40" width="240" height="90" as="geometry"/></mxCell><mxCell id="c3" value="«control»&#10;监测与运维服务&#10;UC9 · UC10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontColor=#1B3A5C;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600" y="40" width="240" height="90" as="geometry"/></mxCell><mxCell id="c4" value="«control»&#10;工单处理服务&#10;UC11 · EXT2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontColor=#1B3A5C;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1270" y="40" width="240" height="90" as="geometry"/></mxCell><mxCell id="reg" value="设备适配注册表" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;html=1;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontColor=#1B3A5C;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="220" width="360" height="96" as="geometry"/></mxCell><mxCell id="reg_a" value="适配器映射：接入类型 → 适配器" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#3A6EA5;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="reg"><mxGeometry x="0" y="28" width="360" height="34" as="geometry"/></mxCell><mxCell id="reg_o" value="取得适配器(接入类型) : 设备适配接口" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontStyle=2;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="reg"><mxGeometry x="0" y="62" width="360" height="34" as="geometry"/></mxCell><mxCell id="dif" value="«interface»&#10;设备适配接口" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=48;html=1;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontColor=#1B3A5C;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="400" width="420" height="142" as="geometry"/></mxCell><mxCell id="dif_o" value="接入(接入参数) : 接入结果&#10;下发指令(设备标识, 指令) : 执行结果&#10;读取状态(设备标识) : 状态采样&#10;执行运维动作(设备标识, 动作) : 执行结果（B05）" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontStyle=2;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="dif"><mxGeometry x="0" y="48" width="420" height="94" as="geometry"/></mxCell><mxCell id="res" value="«datatype»&#10;执行结果" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=48;html=1;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontColor=#1B3A5C;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="360" width="260" height="102" as="geometry"/></mxCell><mxCell id="res_a" value="结果：成功 / 失败 / 未知&#10;设备返回信息" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#3A6EA5;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="res"><mxGeometry x="0" y="48" width="260" height="54" as="geometry"/></mxCell><mxCell id="smp" value="«datatype»&#10;状态采样" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=48;html=1;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontColor=#1B3A5C;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="500" width="260" height="122" as="geometry"/></mxCell><mxCell id="smp_a" value="是否取得&#10;原始读数（随设备，B08）&#10;采样时间" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#3A6EA5;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="smp"><mxGeometry x="0" y="48" width="260" height="74" as="geometry"/></mxCell><mxCell id="usb" value="USB适配器（G1）" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;html=1;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontColor=#1B3A5C;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="260" height="62" as="geometry"/></mxCell><mxCell id="usb_a" value="串口或 HID 参数（B08）" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#3A6EA5;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="usb"><mxGeometry x="0" y="28" width="260" height="34" as="geometry"/></mxCell><mxCell id="ble" value="蓝牙适配器（G2）" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;html=1;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontColor=#1B3A5C;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="680" width="260" height="62" as="geometry"/></mxCell><mxCell id="ble_a" value="蓝牙地址与服务标识（B08）" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#3A6EA5;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="ble"><mxGeometry x="0" y="28" width="260" height="34" as="geometry"/></mxCell><mxCell id="zig" value="Zigbee适配器（G3）" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;html=1;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontColor=#1B3A5C;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="680" width="260" height="62" as="geometry"/></mxCell><mxCell id="zig_a" value="协调器或网关连接（B08）" style="text;html=1;align=left;vertica