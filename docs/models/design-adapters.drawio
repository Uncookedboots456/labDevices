lue="«interface»&#10;AI诊断接口" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=48;html=1;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontColor=#1B3A5C;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1180" y="400" width="420" height="102" as="geometry"/></mxCell><mxCell id="aif_o" value="请求诊断(诊断上下文) : 诊断建议&#10;超时或失败时返回“辅助不可用”" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontStyle=2;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="aif"><mxGeometry x="0" y="48" width="420" height="54" as="geometry"/></mxCell><mxCell id="ctx" value="«datatype»&#10;诊断上下文" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=48;html=1;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontColor=#1B3A5C;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1120" y="620" width="240" height="122" as="geometry"/></mxCell><mxCell id="ctx_a" value="工单描述&#10;设备类型与近期状态&#10;字段与脱敏（B07）" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#3A6EA5;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="ctx"><mxGeometry x="0" y="48" width="240" height="74" as="geometry"/></mxCell><mxCell id="adv" value="«datatype»&#10;诊断建议" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=48;html=1;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontColor=#1B3A5C;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1400" y="620" width="240" height="102" as="geometry"/></mxCell><mxCell id="adv_a" value="建议内容&#10;是否留存（B07）" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#3A6EA5;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="adv"><mxGeometry x="0" y="48" width="240" height="54" as="geometry"/></mxCell><mxCell id="cli" value="AI Agent服务客户端" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;html=1;fillColor=#F5F9FF;strokeColor=#3A6EA5;fontColor=#1B3A5C;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1260" y="900" width="260" height="62" as="geometry"/></mxCell><mxCell id="cli_a" value="提供方与协议（B07）" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#3A6EA5;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="cli"><mxGeometry x="0" y="28" width="260" height="34" as="geometry"/></mxCell><mxCell id="u4" style="dashed=1;endArrow=open;endSize=11;html=1;rounded=0;strokeColor=#1B3A5C;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=13;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c4" target="aif"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="u4l" value="«use» [运维人员请求AI辅助]" style="text;html=1;align=left;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" connectable="0" parent="1"><mxGeometry x="1398" y="250" width="220" height="22" as="geometry"/></mxCell><mxCell id="r3" style="dashed=1;endArrow=open;endSize=11;html=1;rounded=0;strokeColor=#1B3A5C;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=13;exitX=0.1429;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="aif" target="ctx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r3l" value="«use»" style="text;html=1;align=left;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" connectable="0" parent="1"><mxGeometry x="1248" y="556" width="60" height="22" as="geometry"/></mxCell><mxCell id="r4" style="dashed=1;endArrow=open;endSize=11;html=1;rounded=0;strokeColor=#1B3A5C;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=13;exitX=0.8095;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="aif" target="adv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r4l" value="«use»" style="text;html=1;align=left;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" connectable="0" parent="1"><mxGeometry x="1528" y="556" width="60" height="22" as="geometry"/></mxCell><mxCell id="g4" style="endArrow=block;endFill=0;endSize=14;dashed=1;html=1;rounded=0;strokeColor=#1B3A5C;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=13;exitX=0.4615;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.4762;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="cli" target="aif"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note" value="接口设计草图：签名为候选，参数与返回的具体字段随 B05、B07、B08 确定。&#10;三个适配器是 G1–G3 的实现形式，接入时按所选类型取其一，不顺序执行三种接入。&#10;执行结果区分成功、失败、未知，对应图2-13“设备返回可确定结果？”分支。&#10;AI 诊断接口只返回建议，不持有设备适配接口：AI 不操作设备，建议不触发 UC10。" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFF9C4;strokeColor=#B8A000;fontFamily=Noto Sans CJK SC;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1060" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>